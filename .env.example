# Application
NODE_ENV=development
LOG_LEVEL=debug

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=predem_dev
DATABASE_PASSWORD=predem_dev_password
DATABASE_NAME=predem_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=predem-docs
MINIO_REGION=us-east-1

# JWT
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRY=24h

# OCR & Document Processing
OCR_ENABLED=true
OCR_TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=10

# Payments (MTN/Orange - dev mode simulation)
PAYMENT_DEV_MODE=true
MTN_API_URL=https://api.mtn-cameroon.com/v1
ORANGE_API_URL=https://api.orange.cm/v1

# Email
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@predem.douala.cm

# Geo & Maps
MAPS_API_KEY=your_mapbox_key_optional

# Rules Engine
RULES_ENGINE_ENABLED=true
DEFAULT_AUTO_APPROVE_OCR_THRESHOLD=70
DEFAULT_NEEDS_REVIEW_OCR_THRESHOLD=50

# Attestations
ATTESTATION_VALIDITY_DAYS=90
ATTESTATION_AUTHORITY_NAME=Ville de Douala

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
